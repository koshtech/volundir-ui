#!/usr/bin/env bash

# Volundir Development Server Launcher
# Reads .env and starts the chosen backend
# See .env.spec for general options

set -e

# Load .env if it exists
if [ -f ".env" ]; then
  export $(grep -v '^#' .env | xargs)
fi

BACKEND=${BACKEND:-ruby}
PORT=${PORT:-3020}

echo "Starting Volundir development server..."
echo "Backend: $BACKEND"
echo "Port: $PORT"

case "$BACKEND" in
  ruby)
    ruby ./lib/volundir/server/ruby/server.rb
    ;;
  *)
    echo "Unknown backend: $BACKEND"
    exit 1
    ;;
esac
