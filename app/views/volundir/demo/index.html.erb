<h1>Volundir</h1>

<h3>Modal</h3>

<h4>Pure HTML</h4>

<button data-toggle="modal" data-target="#pure-html-modal-example">Open modal</button>

<div class="modal" id="pure-html-modal-example">
  <div class="modal-content">
    <div class="modal-title">
      <button class="close">&times;</button>
      Modal Title
    </div>
    <div class="modal-body">
      <h2>Exemple</h2>
      <p>This is a modal window example, activated by topbar right button.</p>
    </div>
    <div class="modal-footer">
      <button type="button" data-action="submit" data-method="post" class="submit-modal-example btn-success">Submit</button>
      <button type="button" class="btn btn-cancel close">Cancel</button>
    </div>
  </div>
</div>

<h4>Dynamic HTML</h4>

<button data-toggle="modal" data-target="#dynamic-html-modal-example">Open modal</button>

<div class="modal" id="dynamic-html-modal-example">
  <div class="modal-content">
    <div class="modal-title">
      <button class="close">&times;</button>
      Modal Title
    </div>
    <div class="modal-body">
      <h2>Exemple</h2>
      <p>This is a modal window example, activated by topbar right button.</p>
      <ul id="ul-json-data" data-action="populate" data-url="http://localhost:3010/fake_api/users" data-params="active=true&variable=value" data-column-id="id" data-column-label="name"  class="list-numbered">
        <li id="li-json-item"></li>
      </ul>
      <select id="select-json-data" data-action="populate" data-url="http://localhost:3010/fake_api/users" data-params="active=true&variable=value" data-column-id="id" data-column-label="name"  class="list-numbered">
        <option id="option-json-item"></option>
      </select>
    </div>
    <div class="modal-footer">
      <button type="button" data-action="submit" data-method="post" class="submit-modal-example btn-success">Submit</button>
      <button type="button" class="btn btn-cancel close">Cancel</button>
    </div>
  </div>
</div>
