{
  "default": "my_json_api",
  "my_json_api": {
    "type": "json",
    "url": "http://127.0.0.1:3020/api/fake",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json",
      "authorization": "Bearer <token_jwt>"
    }
  },
  "my_rest_api": {
    "type": "restful",
    "url": "http://localhost:3030/fake_rest_api",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json",
      "authorization": "Bearer <token_jwt>"
    }
  }
}

